# ─── LLM ───────────────────────────────────────────────────────────
GROQ_API_KEY_A=gsk_xxxxxxxxxxxxxxxxxxxxxxxx   # agent A (Key1)
GROQ_API_KEY_B=gsk_xxxxxxxxxxxxxxxxxxxxxxxx   # agent B (Key2)
GROQ_MODEL_A=openai/gpt-oss-120b
GROQ_MODEL_B=qwen/qwen3.8-27b
GROQ_TIMEOUT=30

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_A=llama3.1
OLLAMA_MODEL_B=qwen2.5:7b

# ─── Search ────────────────────────────────────────────────────────
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=3

# ─── App ───────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./debate.db
DEBATE_MAX_DURATION=300
VOTING_WINDOW_SECS=15
FRONTEND_URL=http://localhost:3000
PORT=8000

# ─── Debate engine (LangGraph) ─────────────────────────────────────
AGENT_A_NAME=ATLAS
AGENT_B_NAME=NOVA
DEBATE_SECONDS=60
DEBATE_MAX_TURNS=16
MIN_TURN_SECONDS=7
TURN_PAUSE_SECONDS=3.5
WEB_PAUSE_SECONDS=4.5

# ─── LangSmith (observability) ─────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=neural-debate
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
